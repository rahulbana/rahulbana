# Copy to .env and fill in your keys.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Remote MCP server
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8000
